// Konfigurasi deploy Cloudflare Workers (static assets).
// Cloudflare otomatis deploy setiap ada push ke branch main.
{
  "name": "website-berkah-cell",
  "compatibility_date": "2025-09-01",
  // Alamat cadangan *.workers.dev dan link pratinjau per versi.
  // workers.dev diblokir sebagian ISP di Indonesia, jadi alamat resmi memakai domain sendiri.
  "workers_dev": true,
  "preview_urls": true,
  // Domain resmi (dibeli di Hostinger, nameserver di Cloudflare). Cloudflare membuat
  // DNS dan sertifikat HTTPS otomatis. www dialihkan ke domain utama oleh app.js.
  "routes": [
    { "pattern": "berkahcellbatam.com", "custom_domain": true },
    { "pattern": "www.berkahcellbatam.com", "custom_domain": true }
  ],
  "assets": {
    // Hanya folder ini yang dipublikasikan; PRD.md dan file lain tidak ikut.
    "directory": "./site-live"
  },
  // Wajib untuk `wrangler preview` (build branch non-main). Boleh kosong karena
  // Worker ini tidak punya binding; aset tetap diambil dari "assets" di atas.
  "previews": {}
}
